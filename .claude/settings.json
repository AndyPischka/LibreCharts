{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run poe:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
