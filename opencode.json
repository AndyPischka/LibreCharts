{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "ask",
      "uv sync*": "allow",
      "uv run poe *": "allow",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "uv run pyright*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git tag*": "deny",
      "gh release*": "deny",
      "uv add*": "ask",
      "uv remove*": "ask"
    }
  }
}
