<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="org.librecharts.deck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">LibreCharts</value>
          <value xml:lang="de">LibreCharts</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>org.librecharts.deck</value>
        </prop>
        <prop oor:name="IconURL" oor:type="xs:string">
          <value>vnd.sun.star.extension://org.librecharts.extension/images/difference_26.png</value>
        </prop>
        <prop oor:name="HighContrastIconURL" oor:type="xs:string">
          <value>vnd.sun.star.extension://org.librecharts.extension/images/difference_26.png</value>
        </prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">Impress, any, visible ;</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>450</value>
        </prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="org.librecharts.panel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">LibreCharts</value>
          <value xml:lang="de">LibreCharts</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>org.librecharts.panel</value>
        </prop>
        <prop oor:name="DeckId" oor:type="xs:string">
          <value>org.librecharts.deck</value>
        </prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">Impress, any, visible ;</value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string">
          <value>private:resource/toolpanel/org.librecharts/Panel</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>100</value>
        </prop>
        <prop oor:name="ShowForReadOnlyDocuments" oor:type="xs:boolean">
          <value>true</value>
        </prop>
      </node>
    </node>
  </node>
</oor:component-data>
