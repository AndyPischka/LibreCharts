          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/images/level_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="org.librecharts.image4" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:PickAnnotation?kind=cagr</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/images/cagr_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/images/cagr_26.png</value>
          </prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
