<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.librecharts.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">LibreCharts</value>
          <value xml:lang="de">LibreCharts</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="m1" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string">
              <value/>
              <value xml:lang="en-US">Insert column chart</value>
              <value xml:lang="de">Säulendiagramm einfügen</value>
            </prop>
            <prop oor:name="URL" oor:type="xs:string">
              <value>org.librecharts:InsertColumnChart</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
          <node oor:name="m1b" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string">
              <value/>
              <value xml:lang="en-US">Insert bar chart</value>
              <value xml:lang="de">Balkendiagramm einfügen</value>
            </prop>
            <prop oor:name="URL" oor:type="xs:string">
              <value>org.librecharts:InsertBarChart</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
          <node oor:name="m1c" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string">
              <value/>
              <value xml:lang="en-US">Insert waterfall chart</value>
              <value xml:lang="de">Wasserfalldiagramm einfügen</value>
            </prop>
            <prop oor:name="URL" oor:type="xs:string">
              <value>org.librecharts:InsertWaterfallChart</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
          <node oor:name="m1d" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string">
              <value/>
              <value xml:lang="en-US">Insert Marimekko chart</value>
              <value xml:lang="de">Marimekko-Diagramm einfügen</value>
            </prop>
            <prop oor:name="URL" oor:type="xs:string">
              <value>org.librecharts:InsertMekkoChart</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
          <node oor:name="m2" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string">
              <value/>
              <value xml:lang="en-US">Edit chart data</value>
              <value xml:lang="de">Diagrammdaten bearbeiten</value>
            </prop>
            <prop oor:name="URL" oor:type="xs:string">
              <value>org.librecharts:EditData</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
          <node oor:name="m3" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string">
              <value/>
              <value xml:lang="en-US">Add difference arrow</value>
              <value xml:lang="de">Differenzpfeil hinzufügen</value>
            </prop>
            <prop oor:name="URL" oor:type="xs:string">
              <value>org.librecharts:PickAnnotation?kind=difference</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
          <node oor:name="m3b" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string">
              <value/>
              <value xml:lang="en-US">Add level difference</value>
              <value xml:lang="de">Niveaudifferenz hinzufügen</value>
            </prop>
            <prop oor:name="URL" oor:type="xs:string">
              <value>org.librecharts:PickAnnotation?kind=difference&amp;style=level</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
          <node oor:name="m4" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string">
              <value/>
              <value xml:lang="en-US">Add CAGR arrow</value>
              <value xml:lang="de">CAGR-Pfeil hinzufügen</value>
            </prop>
            <prop oor:name="URL" oor:type="xs:string">
              <value>org.librecharts:PickAnnotation?kind=cagr</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
          </node>
        </node>
      </node>
    </node>
    <node oor:name="OfficeToolBar">
      <node oor:name="org.librecharts.toolbar" oor:op="replace">
      <node oor:name="t1" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:InsertColumnChart</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">Insert column chart</value>
          <value xml:lang="de">Säulendiagramm einfügen</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
      </node>
      <node oor:name="t1b" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:InsertBarChart</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">Insert bar chart</value>
          <value xml:lang="de">Balkendiagramm einfügen</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
      </node>
      <node oor:name="t1c" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:InsertWaterfallChart</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">Insert waterfall chart</value>
          <value xml:lang="de">Wasserfalldiagramm einfügen</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
      </node>
      <node oor:name="t1d" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:InsertMekkoChart</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">Insert Marimekko chart</value>
          <value xml:lang="de">Marimekko-Diagramm einfügen</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
      </node>
      <node oor:name="t2" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:EditData</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">Edit chart data</value>
          <value xml:lang="de">Diagrammdaten bearbeiten</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
      </node>
      <node oor:name="t3" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:PickAnnotation?kind=difference</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">Add difference arrow</value>
          <value xml:lang="de">Differenzpfeil hinzufügen</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
      </node>
      <node oor:name="t3b" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:PickAnnotation?kind=difference&amp;style=level</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">Add level difference</value>
          <value xml:lang="de">Niveaudifferenz hinzufügen</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
      </node>
      <node oor:name="t4" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:PickAnnotation?kind=cagr</value>
        </prop>
        <prop oor:name="Title" oor:type="xs:string">
          <value/>
          <value xml:lang="en-US">Add CAGR arrow</value>
          <value xml:lang="de">CAGR-Pfeil hinzufügen</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.presentation.PresentationDocument</value>
        </prop>
      </node>
      </node>
    </node>
    <node oor:name="Images">
      <node oor:name="org.librecharts.image1" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:InsertColumnChart</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/images/insert_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/images/insert_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="org.librecharts.image1b" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:InsertBarChart</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/images/insert_bar_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/images/insert_bar_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="org.librecharts.image1c" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:InsertWaterfallChart</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/images/insert_waterfall_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/images/insert_waterfall_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="org.librecharts.image1d" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:InsertMekkoChart</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/images/insert_mekko_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/images/insert_mekko_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="org.librecharts.image2" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:EditData</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/images/edit_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/images/edit_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="org.librecharts.image3" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:PickAnnotation?kind=difference</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/images/difference_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/images/difference_26.png</value>
          </prop>
        </node>
      </node>
      <node oor:name="org.librecharts.image3b" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.librecharts:PickAnnotation?kind=difference&amp;style=level</value>
