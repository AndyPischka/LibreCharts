<?xml version="1.0" encoding="UTF-8"?>
<description xmlns="http://openoffice.org/extensions/description/2006"
             xmlns:d="http://openoffice.org/extensions/description/2006"
             xmlns:xlink="http://www.w3.org/1999/xlink"
             xmlns:lo="http://libreoffice.org/extensions/description/2011">
  <identifier value="org.librecharts.extension"/>
  <version value="@VERSION@"/>
  <dependencies>
    <!-- The lo: namespace is required; without it LibreOffice rejects the package with
         "unsatisfied dependencies" (AGENTS.md). -->
    <lo:LibreOffice-minimal-version value="25.8" d:name="LibreOffice 25.8"/>
  </dependencies>
  <publisher>
    <name xlink:href="https://github.com/AndyPischka/LibreCharts">Andy Pischka</name>
  </publisher>
  <release-notes>
    <src lang="en" xlink:href="description/release-notes_en.txt"/>
    <src lang="de" xlink:href="description/release-notes_de.txt"/>
  </release-notes>
  <display-name>
    <name lang="en">LibreCharts</name>
    <name lang="de">LibreCharts</name>
  </display-name>
  <icon>
    <default xlink:href="images/icon.png"/>
  </icon>
  <extension-description>
    <src lang="en" xlink:href="description/desc_en.txt"/>
    <src lang="de" xlink:href="description/desc_de.txt"/>
  </extension-description>
</description>
